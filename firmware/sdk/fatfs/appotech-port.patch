+
+/* AppoTech SDK port: retain upstream object locks during sync/format/unmount.
+ * Single cooperative task (FF_FS_REENTRANT=0). See research/sd-write.md. */
+int ff_appotech_volume_busy (const FATFS* fs)
+{
+#if FF_FS_LOCK
+    UINT i;
+    for (i = 0; i < FF_VOLUMES; i++) {
+        if (AppotechRootFs[i] == fs && AppotechRootDirs[i]) return 1;
+    }
+    for (i = 0; i < FF_FS_LOCK; i++) {
+        if (Files[i].fs == fs && Files[i].ctr) return 1;
+    }
+#else
+    (void)fs;
+#endif
+    return 0;
+}
+FRESULT ff_appotech_sync_volume (FATFS* fs)
+{
+    if (!fs || !fs->fs_type) return FR_INVALID_OBJECT;
+#if !FF_FS_READONLY
+    return sync_fs(fs);
+#else
+    return disk_ioctl(fs->pdrv, CTRL_SYNC, 0) == RES_OK ? FR_OK : FR_DISK_ERR;
+#endif
+}
