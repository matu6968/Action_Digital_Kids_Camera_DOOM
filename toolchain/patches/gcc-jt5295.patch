diff --git a/libgcc/config/or1k/appotech-lib1funcs.S b/libgcc/config/or1k/appotech-lib1funcs.S
new file mode 100644
index 00000000000..b202680dc84
--- /dev/null
+++ b/libgcc/config/or1k/appotech-lib1funcs.S
@@ -0,0 +1,116 @@
+/* JT5295 no-delay variants. Same GPL/Runtime Library Exception as lib1funcs.S. */
+    .nodelay
+    .text
+#ifdef L__mulsi3
+    .global __mulsi3
+    .type __mulsi3,@function
+__mulsi3:
+    l.ori r11,r0,0
+1:  l.sfeq r4,r0
+    l.bf 3f
+    l.nop
+    l.andi r5,r4,1
+    l.sfeq r5,r0
+    l.bf 2f
+    l.nop
+    l.add r11,r11,r3
+2:  l.slli r3,r3,1
+    l.srli r4,r4,1
+    l.j 1b
+    l.nop
+3:  l.jr r9
+    l.nop
+    .size __mulsi3,.-__mulsi3
+#endif
+#ifdef L__udivsi3
+    .global __udivsi3
+    .global __udivmodsi3_internal
+    .hidden __udivmodsi3_internal
+    .type __udivsi3,@function
+__udivsi3:
+__udivmodsi3_internal:
+    l.ori r11,r0,0
+    l.ori r12,r3,0
+    l.sfeq r4,r0
+    l.bf 5f
+    l.nop
+    l.ori r6,r0,1
+1:  l.sflts r4,r0
+    l.bf 2f
+    l.nop
+    l.sfltu r4,r12
+    l.bnf 2f
+    l.nop
+    l.slli r4,r4,1
+    l.slli r6,r6,1
+    l.j 1b
+    l.nop
+2:  l.sfleu r4,r12
+    l.bnf 3f
+    l.nop
+    l.sub r12,r12,r4
+    l.or r11,r11,r6
+3:  l.srli r4,r4,1
+    l.srli r6,r6,1
+    l.sfne r6,r0
+    l.bf 2b
+    l.nop
+5:  l.jr r9
+    l.nop
+    .size __udivsi3,.-__udivsi3
+#endif
+#ifdef L__umodsi3
+    .global __umodsi3
+    .type __umodsi3,@function
+__umodsi3:
+    l.ori r13,r9,0
+    l.jal __udivmodsi3_internal
+    l.nop
+    l.ori r11,r12,0
+    l.jr r13
+    l.nop
+    .size __umodsi3,.-__umodsi3
+#endif
+#if defined(L__divsi3) || defined(L__modsi3)
+#ifdef L__divsi3
+    .global __divsi3
+    .type __divsi3,@function
+__divsi3:
+    l.xor r6,r3,r4
+#else
+    .global __modsi3
+    .type __modsi3,@function
+__modsi3:
+    l.ori r6,r3,0
+#endif
+    l.addi r1,r1,-8
+    l.sw 0(r1),r9
+    l.sw 4(r1),r6
+    l.sflts r3,r0
+    l.bnf 1f
+    l.nop
+    l.sub r3,r0,r3
+1:  l.sflts r4,r0
+    l.bnf 2f
+    l.nop
+    l.sub r4,r0,r4
+2:  l.jal __udivmodsi3_internal
+    l.nop
+#ifdef L__modsi3
+    l.ori r11,r12,0
+#endif
+    l.lwz r6,4(r1)
+    l.lwz r9,0(r1)
+    l.addi r1,r1,8
+    l.sflts r6,r0
+    l.bnf 3f
+    l.nop
+    l.sub r11,r0,r11
+3:  l.jr r9
+    l.nop
+#ifdef L__divsi3
+    .size __divsi3,.-__divsi3
+#else
+    .size __modsi3,.-__modsi3
+#endif
+#endif
