diff --git a/gcc/config/or1k/or1k.cc b/gcc/config/or1k/or1k.cc
index ccb23dd2aad..b46d1840bec 100644
--- a/gcc/config/or1k/or1k.cc
+++ b/gcc/config/or1k/or1k.cc
@@ -98,6 +98,14 @@ or1k_option_override (void)
 {
   /* Set the per-function-data initializer.  */
   init_machine_status = or1k_init_machine_status;
+  if (TARGET_APPOTECH)
+    {
+      target_flags |= MASK_LITTLE_ENDIAN | MASK_SOFT_MUL | MASK_SOFT_DIV;
+      target_flags &= ~MASK_HARD_FLOAT;
+      flag_delayed_branch = 0;
+      if (flag_pic)
+        error ("-mappotech does not yet support position-independent code");
+    }
 }
 
 /* Returns true if REGNO must be saved for the current function.  */
@@ -2280,6 +2288,17 @@ or1k_libm_function_max_error (unsigned cfn, machine_mode mode,
   return default_libm_function_max_error (cfn, mode, boundary_p);
 }
 
+/* JT5295 calls return to PC+4. Keep NOP slots but mark the actual ISA. */
+static void
+or1k_asm_file_start (void)
+{
+  default_file_start ();
+  if (TARGET_APPOTECH)
+    fputs ("\t.nodelay\n", asm_out_file);
+}
+#undef TARGET_ASM_FILE_START
+#define TARGET_ASM_FILE_START or1k_asm_file_start
+
 #undef  TARGET_ASM_OUTPUT_MI_THUNK
 #define TARGET_ASM_OUTPUT_MI_THUNK or1k_output_mi_thunk
 #undef  TARGET_ASM_CAN_OUTPUT_MI_THUNK
